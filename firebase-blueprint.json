{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Institutional profile for DecisionLab users",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The unique Firebase Auth UID" },
        "fullName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email", "description": "Verified email address" },
        "startupName": { "type": "string", "description": "Associated venture or project" },
        "roleType": { 
          "type": "string", 
          "enum": ["Founder", "Investor", "Operator", "Analyst", "Builder", "Student"],
          "description": "Institutional role within the venture ecosystem"
        },
        "roleDescription": { "type": "string", "description": "Specific functional role" },
        "onboardingCompleted": { "type": "boolean", "description": "Whether the user has finished the onboarding flow" },
        "companyName": { "type": "string" },
        "companyLogo": { "type": "string" },
        "industry": { "type": "string" },
        "companyDescription": { "type": "string" },
        "startupStage": { "type": "string" },
        "pitchSummary": { "type": "string" },
        "founderInfo": { "type": "string" },
        "teamMembers": { "type": "array" },
        "location": { "type": "string" },
        "businessType": { "type": "string" },
        "productType": { "type": "string" },
        "pitchDeckUrl": { "type": "string" },
        "teamStructure": { "type": "string" },
        "sectors": { "type": "array" },
        "companyAnalysis": { "type": "object" },
        "pitchDeck": { "type": "object" },
        "subscriptionStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName", "email", "roleType", "onboardingCompleted"]
    },
    "VentureAnalysis": {
      "title": "Venture Analysis",
      "description": "Stored intelligence reports generated by the platform",
      "type": "object",
      "properties": {
        "analysisId": { "type": "string" },
        "userId": { "type": "string" },
        "startupName": { "type": "string" },
        "industry": { "type": "string" },
        "score": { "type": "number" },
        "reportData": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["analysisId", "userId", "reportData"]
    },
    "IntelligenceSession": {
      "title": "Intelligence Session",
      "description": "Stored chat sessions with the Strategic Intelligence Desk",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "userId", "messages"]
    },
    "PitchDeck": {
      "title": "Pitch Deck",
      "description": "Institutional pitch decks architected by founders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "projectName": { "type": "string" },
        "linkedAnalysisId": { "type": "string" },
        "slides": { "type": "array" },
        "template": { "type": "string" },
        "theme": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "projectName", "slides"]
    },
    "SavedComparison": {
      "title": "Saved Comparison",
      "description": "Stored venture comparisons",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "ids": { "type": "array" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "ids", "name"]
    },
    "UserProject": {
      "title": "User Project",
      "description": "Startup projects initiated by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "industry": { "type": "string" },
        "country": { "type": "string" },
        "stage": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "object" },
        "lastUpdated": { "type": "object" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Secure user profile documents accessible only by the owner"
    },
    "/analyses/{analysisId}": {
      "schema": "VentureAnalysis",
      "description": "Individual venture analysis reports"
    },
    "/sessions/{sessionId}": {
      "schema": "IntelligenceSession",
      "description": "Stored intelligence desk sessions"
    },
    "/pitchDecks/{projectId}": {
      "schema": "PitchDeck",
      "description": "Stored pitch decks architected by the system"
    },
    "/savedComparisons/{comparisonId}": {
      "schema": "SavedComparison",
      "description": "Saved comparative analyses"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "UserProject",
      "description": "User specific projects inside nested directory structure"
    }
  }
}
