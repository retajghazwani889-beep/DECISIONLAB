rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'retajghazwani889@gmail.com'; }
    function isInvestor() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.accountType == 'investor';
    }

    // Billing fields are server-only — the Admin SDK (webhook) writes them and
    // bypasses these rules. Clients may never touch them, even their own profile.
    function touchesBillingFields() {
      let billing = [
        'subscriptionStatus', 'subscriptionUpdatedAt', 'subscriptionStartedAt',
        'subscriptionCancelAt', 'gumroadSubscriptionId', 'gumroadSaleId'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(billing);
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Clients may create their own profile only if subscriptionStatus is absent
      // or explicitly 'free'. They may never write billing fields on update.
      allow create: if (isOwner(userId) || isAdmin())
                    && (!('subscriptionStatus' in request.resource.data)
                        || request.resource.data.subscriptionStatus == 'free');
      allow update: if isAdmin()
                    || (isOwner(userId) && !touchesBillingFields());
      allow delete: if isAdmin();
    }

    match /analyses/{analysisId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid)
                    || isAdmin()
                    || (isInvestor() && resource.data.sharedWithInvestors == true);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /investorApplications/{appId} {
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /pitchDecks/{projectId} {
      allow read: if (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /savedComparisons/{comparisonId} {
      allow read: if (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /users/{userId}/projects/{projectId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}